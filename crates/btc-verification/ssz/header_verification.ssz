import strata_identifiers

TIMESTAMPS_FOR_MEDIAN = 11

### SSZ delegate for the sliding timestamp window used for Bitcoin header
### validation. The ring buffer is always fully populated, so it is a fixed
### vector; `head` must index into it (validated on decode).
class TimestampStoreSsz(Container):
    buffer: Vector[uint32, TIMESTAMPS_FOR_MEDIAN]
    head: uint8

### SSZ delegate for Bitcoin header verification state.
### These fields are the minimal chain view needed to verify the next header(s):
### the committed tip, current target/epoch context, timestamp window, and
### cumulative work. Full block bodies and older headers are intentionally omitted.
class HeaderVerificationStateSsz(Container):
    ### Serialized Bitcoin network identifier; the full consensus params are
    ### derived from it on decode.
    network: uint8
    #~# external_kind: container
    last_verified_block: strata_identifiers.L1BlockCommitment
    next_block_target: uint32
    epoch_start_timestamp: uint32
    block_timestamp_history: TimestampStoreSsz
    ### Total accumulated proof of work.
    total_accumulated_pow: uint256
