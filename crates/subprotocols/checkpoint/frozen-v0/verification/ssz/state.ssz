# Checkpoint subprotocol state as released in v0.3.0-rc.2.
#
# FROZEN. Taken verbatim from tag v0.3.0-rc.2 (commit 45a1fa2) at
# `crates/subprotocols/checkpoint/verification/ssz/state.ssz`, and generated by
# the same ssz-gen the released code used, so the encoding is reproduced by the
# generator rather than by transcription.
#
# Diff against that tag: the only differences are the two DEVIATION comments
# below. Both are redirections to a renamed or frozen crate; neither touches the
# wire format.
#
# Changing anything here changes how already-committed state is read, which is a
# consensus change wearing a refactor's clothes.

import strata_predicate
# DEVIATION 1/2: the amount type is the current strata_btc_types rather than
# a frozen copy of the released one. The encoding is identical -- eight
# little-endian bytes of satoshis -- so stored sections are byte-for-byte
# unchanged. Construction stays unchecked, via the infallible From<Amount>
# that the current type documents as trusting its caller, matching the
# released from_sat. The one difference is decoding: the current type rejects
# a value above the money supply where the released codec accepted any u64.
# The only amount stored here is the denomination, which is set from a
# deposit output and is therefore bounded by Bitcoin consensus far below
# that limit.
import strata_btc_types
# DEVIATION 2/2: the types crate was renamed
# (strata_asm_proto_checkpoint_types -> strata_asm_checkpoint_types).
# `CheckpointTip` itself is byte-identical across the boundary -- the whole
# of checkpoint/types/ssz/payload.ssz is unchanged between the two tags --
# so this is a name change, not a layout change.
import strata_asm_checkpoint_types

### Pool of bridge UTXOs available to honor withdrawals.
###
### Defaults to empty (denomination = `ZERO`, count = 0). The denomination is fixed by
### the first recorded deposit; from then on, every deposit and withdrawal intent must
### match it.
class DepositPool(Container):
    ### Bridge deposit denomination. Trivially zero until the first deposit fixes it.
    denomination: strata_btc_types.BitcoinAmount

    ### Count of bridge UTXOs that have been processed but not yet consumed by withdrawals.
    count: uint32

### Checkpoint subprotocol state.
class CheckpointState(Container):
    ### Predicate for sequencer signature verification.
    ### Updated via `UpdateSequencerKey` message from admin subprotocol.
    #~# external_kind: container
    sequencer_predicate: strata_predicate.PredicateKey

    ### Predicate for checkpoint ZK proof verification.
    ### Updated via `UpdateCheckpointPredicate` message from admin subprotocol.
    #~# external_kind: container
    checkpoint_predicate: strata_predicate.PredicateKey

    ### Last verified checkpoint tip position.
    ### Tracks the OL state that has been proven and verified by ASM.
    #~# external_kind: container
    verified_tip: strata_asm_checkpoint_types.CheckpointTip

    ### Bridge UTXOs available to honor withdrawals.
    deposits: DepositPool
