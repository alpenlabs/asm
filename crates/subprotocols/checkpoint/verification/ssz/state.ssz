import strata_predicate
import strata_identifiers
import strata_btc_types
import strata_asm_checkpoint_types

### At most one OL predicate rotation may be outstanding at a time. Administration
### refuses to authorize a rotation while another is queued or awaiting activation, so
### this slot is always free when an enactment arrives.
MAX_PENDING_PREDICATE_TRANSITIONS = 1

### Pool of bridge UTXOs available to honor withdrawals.
###
### Defaults to empty (denomination = `ZERO`, count = 0). The denomination is fixed by
### the first recorded deposit; from then on, every deposit and withdrawal intent must
### match it.
class DepositPool(Container):
    ### Bridge deposit denomination. Trivially zero until the first deposit fixes it.
    denomination: strata_btc_types.BitcoinAmount

    ### Count of bridge UTXOs that have been processed but not yet consumed by withdrawals.
    count: uint32

### Checkpoint subprotocol state.
class CheckpointState(Container):
    ### X-only BIP340 Schnorr key that must appear in the checkpoint envelope container.
    ### Updated via `UpdateSequencerKey` message from admin subprotocol.
    sequencer_key: strata_identifiers.Buf32

    ### Active predicate for checkpoint ZK proof verification.
    #~# external_kind: container
    checkpoint_predicate: strata_predicate.PredicateKey

    ### Enacted predicate transitions awaiting activation, ordered by boundary.
    ###
    ### Every entry has a boundary strictly above `verified_tip.l1_height`: a transition is
    ### enacted at the L1 height being processed, which is always above the height any
    ### checkpoint has covered, and an entry is promoted as soon as the tip reaches it. So
    ### `checkpoint_predicate` always governs `verified_tip.l1_height + 1`.
    #~# external_kind: container
    pending_transition: List[strata_asm_checkpoint_types.PendingPredicateTransition, MAX_PENDING_PREDICATE_TRANSITIONS]

    ### Last verified checkpoint tip position.
    ### Tracks the OL state that has been proven and verified by ASM.
    #~# external_kind: container
    verified_tip: strata_asm_checkpoint_types.CheckpointTip

    ### Bridge UTXOs available to honor withdrawals.
    deposits: DepositPool
