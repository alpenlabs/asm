# SSZ schema definitions for the administration threshold-signature types.
#
# These containers define the wire layout of the threshold-signature types. The
# Rust wrappers encode by converting to the container generated from this file,
# so the layout is correct by construction rather than hand-rolled.
#
# Signers are modelled as raw 20-byte P2WPKH witness programs (`Bytes20`) rather
# than the `P2wpkhAddress` wrapper, which keeps the generated container free of
# any dependency on the wrapper's own trait impls. Every 20-byte value is a
# well-formed program, so there is nothing to revalidate on decode.

### Maximum number of signers in a threshold configuration.
###
### Matches the `MAX_SIGNERS` runtime cap (the signer index is a `u8`, so at
### most 256 unique signers are addressable).
MAX_SIGNERS = 256

### Wire layout of a threshold-signature configuration.
class ThresholdConfigSsz(Container):
    ### P2WPKH witness programs of all authorized signers.
    signers: List[Bytes20, MAX_SIGNERS]
    ### Minimum number of signatures required (always >= 1).
    threshold: uint8

### Wire layout of a threshold-configuration update.
class ThresholdConfigUpdateSsz(Container):
    ### Signer addresses to add.
    add_members: List[Bytes20, MAX_SIGNERS]
    ### Signer addresses to remove.
    remove_members: List[Bytes20, MAX_SIGNERS]
    ### New minimum number of signatures required (always >= 1).
    new_threshold: uint8

### Wire layout of a single indexed ECDSA signature.
class IndexedSignatureSsz(Container):
    ### Index of the signer in the threshold config signer list.
    index: uint8
    ### 65-byte recoverable ECDSA signature (header || r || s).
    signature: Vector[uint8, 65]

### Wire layout of a set of indexed signatures (one per signer at most).
class SignatureSetSsz(Container):
    ### Indexed signatures, at most one per signer.
    signatures: List[IndexedSignatureSsz, MAX_SIGNERS]
